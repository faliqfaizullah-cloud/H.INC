<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="18dp">
    <ImageView android:layout_width="20dp" android:layout_height="24dp"
        android:layout_alignParentTop="true" android:layout_alignParentEnd="true"
        android:src="@drawable/ic_parens" android:contentDescription="H.INC"/>
    <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Sugar" android:textColor="#FFFFFF" android:textSize="17sp" android:textStyle="bold"
        android:fontFamily="monospace" android:maxLines="2"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Latest"
            android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/w_latest" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8A8A8A" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Average"
            android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/w_avg" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8A8A8A" android:textSize="12sp" android:fontFamily="monospace" android:layout_marginBottom="6dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Time in range"
            android:textColor="#FFFFFF" android:textSize="12sp" android:fontFamily="monospace"/>
        <TextView android:id="@+id/w_tir" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#8A8A8A" android:textSize="12sp" android:fontFamily="monospace"/>
    </LinearLayout>
</RelativeLayout>
