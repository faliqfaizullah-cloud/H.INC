<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_bg" android:padding="14dp">

    <ImageView android:id="@+id/w_route" android:layout_width="match_parent" android:layout_height="64dp"
        android:layout_alignParentTop="true" android:scaleType="fitCenter" android:contentDescription="Route"/>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" android:layout_alignParentStart="true" android:orientation="vertical">
        <TextView android:id="@+id/w_title" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Morning Run" android:textColor="#E6FFFFFF" android:textSize="10sp" android:maxLines="1"
            android:fontFamily="sans-serif-light" android:shadowColor="#66000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="6"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="bottom">
            <TextView android:id="@+id/w_dist" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="0.00" android:textColor="#FFFFFFFF" android:textSize="26sp" android:maxLines="1"
                android:fontFamily="sans-serif-thin" android:shadowColor="#66000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="8"/>
            <TextView android:id="@+id/w_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text=" KM" android:textColor="#B3FFFFFF" android:textSize="8sp" android:layout_marginBottom="5dp"
                android:fontFamily="sans-serif-light"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_alignParentBottom="true" android:layout_alignParentEnd="true" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="0:00" android:textColor="#F2FFFFFF" android:textSize="10sp" android:fontFamily="sans-serif-light"
            android:shadowColor="#66000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="6"/>
        <TextView android:id="@+id/w_bpm" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="-- bpm" android:textColor="#F2FFFFFF" android:textSize="10sp" android:fontFamily="sans-serif-light"
            android:shadowColor="#66000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="6"/>
        <TextView android:id="@+id/w_pace" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="--:--" android:textColor="#F2FFFFFF" android:textSize="10sp" android:fontFamily="sans-serif-light"
            android:shadowColor="#66000000" android:shadowDx="0" android:shadowDy="2" android:shadowRadius="6"/>
    </LinearLayout>
</RelativeLayout>
